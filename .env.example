# ReconAI Environment Configuration
APP_NAME=ReconAI
APP_VERSION=1.0.0
DEBUG=True

# Database (Default: SQLite for instant zero-dependency local running; or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./reconai.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reconai

# OpenAI (Optional - if omitted, intelligent local financial heuristics engine is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Vector DB (Optional)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=reconai-transactions
PINECONE_ENVIRONMENT=us-east-1

# Reconciliation Safety Guardrails
AUTO_RESOLVE_MAX_AMOUNT=10000.0
AMOUNT_TOLERANCE_PERCENT=0.5
AMOUNT_TOLERANCE_ABSOLUTE=100.0
FUZZY_MATCH_THRESHOLD=0.85
